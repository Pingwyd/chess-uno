{
  "name": "chess-uno",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chess Uno: chess where a card decides how many moves you make.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "screenshots": "node scripts/screenshots.mjs",
    "server": "npm run start -w server",
    "server:dev": "npm run dev -w server",
    "test:server": "npm test -w server"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "server"
  ]
}
